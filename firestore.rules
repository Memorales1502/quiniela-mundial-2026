rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.email == "memoralesre@gmail.com"
          || request.auth.token.email == "admin@quiniela.com"
        );
    }

    match /users/{doc} {
      allow read, write: if signedIn();
    }

    match /players/{doc} {
      allow read, write: if signedIn();
    }

    match /predictions/{doc} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.submitted == true
        && request.resource.data.locked == true;

      allow update, delete: if false;
    }

    match /predictions16/{doc} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.submitted == true
        && request.resource.data.locked == true;

      allow update, delete: if false;
    }

    match /predictions8/{doc} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.submitted == true
        && request.resource.data.locked == true;

      allow update, delete: if false;
    }

    match /results/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /results16/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /results8/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /matches/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /rankings/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
